extends layout

block content
  h1= title
  if errors
    ul.errors
      each error in errors
        li= error.msg
  form(method="post" action="")
    div
      label(for="name") Nome da categoria:
      input#name(type="text" name="name" value=category.name)
    div
      button(type="submit") Salvar
      a(href="/sports") Voltar
